# Docker Compose overrides for the production VPS
STACK_VERSION=latest

# Network ports exposed on the VPS
BACKEND_PORT=33221
FRONTEND_PORT=33321
MONGO_EXPRESS_PORT=34817
MONGO_EXPRESS_PASSWORD=change_this_password

# Backend runtime configuration
MONGODB_URI=mongodb://mongo:27017/stolovayaGAU
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d
NODE_ENV=production
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=s3-stolovayagau
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
