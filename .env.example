# Common settings for docker-compose
COMPOSE_PROJECT_NAME=stolovaya

# Networking
BACKEND_PORT=33221
FRONTEND_PORT=33321
MONGO_PORT=27017
MONGO_EXPRESS_PORT=34817
MONGO_EXPRESS_PASSWORD=change_me

# Backend configuration
MONGODB_URI=mongodb://mongo:27017/stolovayaGAU
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d
NODE_ENV=production
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=s3-stolovayagau
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1

# Frontend build configuration
FRONTEND_API_BASE_URL=http://localhost:33221/api
